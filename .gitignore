# ══════════════════════════════════════════════════════════════
# CREDENTIALS & SECRETS — never commit
# These entries exist BEFORE the files they protect (Phase 0).
# ══════════════════════════════════════════════════════════════
.env
.env.*
!.env.example
credentials/*
!credentials/.gitignore
!credentials/README.md
*.key
*.pem
*.p12
secrets.json
mt5_account.json

# ══════════════════════════════════════════════════════════════
# MARKET DATA — captured payloads are large and re-capturable.
# The repo tracks code and schema, never the archive.
# ══════════════════════════════════════════════════════════════
data/**
!data/**/.gitkeep

# ══════════════════════════════════════════════════════════════
# LOGS
# ══════════════════════════════════════════════════════════════
*.log
logs/

# ══════════════════════════════════════════════════════════════
# GENERATED REPORTS -- backtest/research output and pytest run logs,
# regenerable from code + data. Organized under one directory
# (confirmed 2026-09-18) instead of loose files at the repo root, but
# still never committed -- same category as data/ and logs/ above.
# git note: directories must be un-ignored explicitly before a nested
# file can be re-included (a bare `!reports/**/x` does not work once
# `reports/**` has already excluded the directory tree itself).
# ══════════════════════════════════════════════════════════════
reports/*
!reports/backtests/
!reports/pytest/
reports/backtests/*
!reports/backtests/.gitkeep
reports/pytest/*
!reports/pytest/.gitkeep
!reports/pytest/README.md

# ══════════════════════════════════════════════════════════════
# PYTHON
# ══════════════════════════════════════════════════════════════
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ══════════════════════════════════════════════════════════════
# VIRTUAL ENVIRONMENTS
# ══════════════════════════════════════════════════════════════
.venv/
venv/
env/

# ══════════════════════════════════════════════════════════════
# METATRADER — compiled output is a build artifact, not source
# ══════════════════════════════════════════════════════════════
*.ex5
*.ex4

# ══════════════════════════════════════════════════════════════
# EDITORS / OS
# ══════════════════════════════════════════════════════════════
.vscode/
.idea/
.DS_Store
Thumbs.db
